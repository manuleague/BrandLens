{
  "name": "brandlens",
  "version": "0.1.0",
  "description": "BrandLens — platformă GEO + SEO: vizibilitate în ChatGPT, Gemini, Perplexity și Claude, audit AI-readiness și plan de acțiuni bifabil.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/core.test.ts test/v2.test.ts",
    "audit": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts audit",
    "typecheck": "tsc -p ."
  },
  "license": "UNLICENSED"
}
