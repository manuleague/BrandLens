# BrandLens — copiați acest fișier în .env și completați cheile pe care le aveți.
# Fiecare motor e opțional; aplicația folosește doar motoarele care au cheie.

# ChatGPT (Responses API + web_search) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Claude (Messages API + web search tool; activați web search în Console) — https://console.anthropic.com
# ATENȚIE: cheia API începe cu sk-ant-api…; tokenurile de abonament Claude (sk-ant-oat…) NU funcționează.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini (generateContent + Google Search grounding) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model de rezervă când cel principal e suprasolicitat (503). Gol sau „auto” = ales automat din modelele
# disponibile pentru cheia dvs. Puneți un nume exact (ex. din lista de la „Testează conexiunile”) doar dacă vreți altul.
GEMINI_FALLBACK_MODEL=auto
# 1 = adaugă și Grounding with Google Maps pentru business-uri locale (cost suplimentar)
GEMINI_MAPS=0

# Perplexity (Sonar) — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Analiza AI (profilare site, generare prompturi, analiza fiecărui răspuns, optimizator, recomandări).
# Implicit activă dacă există cel puțin o cheie validă. 0 = doar reguli deterministe (fără cost suplimentar).
ANALYSIS=1
# Opțional: forțați furnizorul și un model ieftin pentru analiză (openai | anthropic | gemini | perplexity)
# ANALYSIS_PROVIDER=anthropic
# ANALYSIS_MODEL=claude-haiku-5-5

# Server
PORT=4321
# 0.0.0.0 doar în Docker / în spatele unui reverse proxy cu HTTPS
HOST=127.0.0.1
# Dacă e setată, interfața și API-ul cer autentificare (utilizator: oricare, parola: aceasta)
BRANDLENS_PASSWORD=
# DB_PATH=./data/brandlens.db
ENGINE_TIMEOUT_MS=90000
